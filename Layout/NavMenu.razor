@inject NavigationManager Nav

<div class="bottom-tabs-inner">
    <a class="@TabClass("workouts")" href="/workouts">
        <div class="tab @TabActive("workouts")">
            <div class="emoji">🏋️</div>
            <div class="label">Workouts</div>
        </div>
    </a>

    <a class="@TabClass("history")" href="/history">
        <div class="tab @TabActive("history")">
            <div class="emoji">📅</div>
            <div class="label">History</div>
        </div>
    </a>
</div>

@code {
    private string CurrentPath => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');

    private string TabActive(string route)
    {
        var r = route.TrimEnd('/');
        if (r == "") r = "/";
        return CurrentPath == r ? "active" : "";
    }

    private string TabClass(string route) => "tablink";
}