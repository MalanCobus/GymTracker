@page "/workouts"
@using GymTracker.Models
@inject GymTracker.Services.WorkoutStore Store
@inject NavigationManager Nav

<PageTitle>Workouts</PageTitle>

<div class="rowx" style="justify-content: space-between;">
    <div>
        <div class="title">Workouts</div>
        <div class="kicker">Saved workouts (no dates). Tap “Do workout” to log a session.</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="cardx" style="border-color: color-mix(in oklab, var(--danger), transparent 40%);">
        <div style="font-weight:850;">Oops</div>
        <div class="small">@_error</div>
    </div>
}

<div class="cardx">
    <div class="grid2">
        <input class="inputx" placeholder="Search workout…" @bind="_query" @bind:event="oninput" />
        <div class="rowx" style="justify-content:flex-end;">
            <button class="btnx primary" @onclick="CreateAsync">➕ Create</button>
        </div>
    </div>
</div>

@if (Filtered.Count == 0)
{
    <div class="cardx">
        <div style="font-weight:850;">No workouts</div>
        <div class="small">Create one, then reuse it forever.</div>
    </div>
}
else
{
    @foreach (var d in Filtered)
    {
        <div class="cardx">
            <div class="rowx" style="justify-content: space-between;">
                <div style="min-width: 200px;">
                    <div style="font-weight:850; font-size: 1.08rem;">@d.Name</div>
                    <div class="small">@string.Join(" · ", d.Exercises.Select(e => e.Name))</div>
                </div>

                <div class="rowx">
                    <button class="btnx ok" @onclick="() => DoWorkoutAsync(d.Id)">▶️ Do workout</button>
                    <a class="btnx" href="@($"/workouts/{d.Id}")">✏️ Edit</a>

                    @if (_pendingDeleteId == d.Id)
                    {
                        <button class="btnx danger" @onclick="() => ConfirmDeleteAsync(d.Id)">Delete</button>
                        <button class="btnx" @onclick="CancelDelete">Cancel</button>
                    }
                    else
                    {
                        <button class="btnx danger" @onclick="() => AskDelete(d.Id)">🗑️</button>
                    }
                </div>
            </div>

            <hr class="sep" />

            <div class="rowx">
                <span class="pill">Exercises: @d.Exercises.Count</span>
                <span class="pill">Sets: @d.Exercises.Sum(e => e.Sets.Count)</span>
            </div>

            @if (_pendingDeleteId == d.Id)
            {
                <div style="margin-top: 10px;" class="small">
                    This deletes the saved workout. Your history stays (unless you want it removed too).
                </div>
            }
        </div>
    }
}

@code {
    private string? _error;
    private string _query = "";
    private Guid? _pendingDeleteId;

    private IReadOnlyList<WorkoutDefinition> Filtered
        => Store.Definitions
            .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .Where(d =>
                string.IsNullOrWhiteSpace(_query)
                || d.Name.Contains(_query, StringComparison.OrdinalIgnoreCase)
                || d.Exercises.Any(e => e.Name.Contains(_query, StringComparison.OrdinalIgnoreCase)))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await Store.EnsureLoadedAsync();
    }

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            var d = await Store.CreateDefinitionAsync("Workout");
            Nav.NavigateTo($"workouts/{d.Id}");
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task DoWorkoutAsync(Guid definitionId)
    {
        _error = null;
        try
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var session = await Store.StartWorkoutAsync(definitionId, today);
            Nav.NavigateTo($"current/{session.Id}");
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void AskDelete(Guid id) => _pendingDeleteId = id;
    private void CancelDelete() => _pendingDeleteId = null;

    private async Task ConfirmDeleteAsync(Guid id)
    {
        _error = null;
        try
        {
            await Store.DeleteDefinitionAsync(id);
            _pendingDeleteId = null;
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
