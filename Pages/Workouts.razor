@page "/workouts"
@using GymTracker.Models
@using Microsoft.Extensions.Logging
@inject GymTracker.Services.WorkoutStore Store
@inject NavigationManager Nav
@inject ILogger<Workouts> Logger
@inject GymTracker.Services.IToastService Toasts

<PageTitle>Workouts</PageTitle>

<div class="pagehead">
    <div class="pagehead-left">
        <div class="pagehead-title">Workouts</div>
    </div>

    <div class="pagehead-actions">
        <span class="pill">@Store.Definitions.Count workout(s)</span>
        <button class="btnx primary" @onclick="Create" title="Create a new workout">➕ Create</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="cardx" style="border-color: color-mix(in oklab, var(--danger), transparent 40%);">
        <div style="font-weight:850;">Oops</div>
        <div class="small">@_error</div>
    </div>
}

<div class="cardx">
    <div class="grid2">
        <input class="inputx" placeholder="Search workout…" @bind="_query" @bind:event="oninput" />
        <div class="rowx" style="justify-content:flex-end;">
            <button class="btnx" type="button" @onclick="ClearSearch" disabled="@string.IsNullOrWhiteSpace(_query)">
                Clear
            </button>
        </div>
    </div>
</div>

@if (Filtered.Count == 0)
{
    <div class="cardx">
        <div style="font-weight:850;">No workouts</div>
        <div class="small">Create one, then reuse it forever.</div>
    </div>
}
else
{
    @foreach (var d in Filtered)
    {
        var exercisesCount = d.Exercises?.Count ?? 0;
        var setsCount = d.Exercises?.Sum(e => e.Sets?.Count ?? 0) ?? 0;

        <div class="cardx">
            <div class="rowx" style="justify-content: space-between;">
                <div style="min-width: 200px;">
                    <div style="font-weight:850; font-size: 1.08rem;">
                        @DisplayName(d.Name)
                    </div>
                    <div class="small">
                        @(exercisesCount == 0
                                        ? "No exercises yet"
                                        : string.Join(" · ", d.Exercises.Select(e => string.IsNullOrWhiteSpace(e.Name) ? "Exercise" : e.Name)))
                    </div>
                </div>

                <div class="rowx">
                    <button class="btnx"
                            type="button"
                            @onclick="() => DoWorkoutAsync(d.Id)"
                            disabled="@(exercisesCount == 0)"
                            title="Start today’s session">
                        ▶️ Do workout
                    </button>

                    <a class="btnx" href="@($"/workouts/{d.Id}")" title="Edit workout">✏️ Edit</a>

                    @if (_pendingDeleteId == d.Id)
                    {
                        <button class="btnx danger" type="button" @onclick="() => ConfirmDeleteAsync(d.Id)">Delete</button>
                        <button class="btnx" type="button" @onclick="CancelDelete">Cancel</button>
                    }
                    else
                    {
                        <button class="btnx danger" type="button" @onclick="() => AskDelete(d.Id)" title="Delete workout">🗑️</button>
                    }
                </div>
            </div>

            <hr class="sep" />

            <div class="rowx">
                <span class="pill">Exercises: @exercisesCount</span>
                <span class="pill">Sets: @setsCount</span>
            </div>

            @if (_pendingDeleteId == d.Id)
            {
                <div style="margin-top: 10px;" class="small">
                    Deletes this saved workout. Your history sessions stay.
                </div>
            }

            @if (exercisesCount == 0)
            {
                <div style="margin-top: 10px;" class="small">
                    Add at least 1 exercise before starting a workout.
                </div>
            }
        </div>
    }
}

@code {
    private string? _error;
    private string _query = "";
    private Guid? _pendingDeleteId;

    protected override async Task OnInitializedAsync()
    {
        await Store.EnsureLoadedAsync();
        Logger.LogInformation("Loaded workouts page. Workouts={WorkoutCount}", Store.Definitions.Count);
    }

    private IReadOnlyList<WorkoutDefinition> Filtered
        => Store.Definitions
            .OrderBy(x => string.IsNullOrWhiteSpace(x.Name) ? "zzz" : x.Name, StringComparer.OrdinalIgnoreCase)
            .Where(d =>
                string.IsNullOrWhiteSpace(_query)
                || (d.Name ?? "").Contains(_query, StringComparison.OrdinalIgnoreCase)
                || d.Exercises.Any(e => (e.Name ?? "").Contains(_query, StringComparison.OrdinalIgnoreCase)))
            .ToList();

    private static string DisplayName(string? name)
        => string.IsNullOrWhiteSpace(name) ? "(Unnamed workout)" : name.Trim();

    private void Create()
    {
        Logger.LogInformation("Navigating to new workout draft.");
        Nav.NavigateTo("/workouts/new");
    }

    private void ClearSearch()
    {
        _query = "";
        Logger.LogInformation("Cleared workout search.");
    }

    private async Task DoWorkoutAsync(Guid definitionId)
    {
        _error = null;

        try
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var session = await Store.StartWorkoutAsync(definitionId, today);

            Logger.LogInformation(
                "Started workout from definition. DefinitionId={DefinitionId} SessionId={SessionId} Date={WorkoutDate}",
                definitionId, session.Id, session.WorkoutDate);

            Nav.NavigateTo($"/current/{session.Id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogError(ex, "Failed to start workout. DefinitionId={DefinitionId}", definitionId);
        }
    }

    private void AskDelete(Guid id)
    {
        _pendingDeleteId = id;
        Logger.LogInformation("Delete requested (confirmation step). DefinitionId={DefinitionId}", id);
    }

    private void CancelDelete()
    {
        Logger.LogInformation("Delete cancelled. PendingDefinitionId={PendingDefinitionId}", _pendingDeleteId);
        _pendingDeleteId = null;
    }

    private async Task ConfirmDeleteAsync(Guid id)
    {
        _error = null;

        try
        {
            await Store.DeleteDefinitionAsync(id);
            Logger.LogInformation("Deleted workout definition. DefinitionId={DefinitionId}", id);
            _pendingDeleteId = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogError(ex, "Failed to delete workout definition. DefinitionId={DefinitionId}", id);
        }
    }
}
