@page "/history"
@using GymTracker.Models
@inject GymTracker.Services.WorkoutStore Store

<PageTitle>History</PageTitle>

<div>
    <div class="title">History</div>
    <div class="kicker">Your completed (or in-progress) workout sessions, grouped by date.</div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="cardx" style="border-color: color-mix(in oklab, var(--danger), transparent 40%);">
        <div style="font-weight:800;">Oops</div>
        <div class="small">@_error</div>
    </div>
}

@if (Store.Sessions.Count == 0)
{
    <div class="cardx">
        <div style="font-weight:850;">No history yet</div>
        <div class="small">Open Workouts → tap “Do workout”.</div>
    </div>
}
else
{
    @foreach (var group in Store.GetHistoryGroupedByDate())
    {
        <div class="cardx">
            <div class="rowx" style="justify-content: space-between;">
                <div style="font-weight:850;">@group.Date.ToString("yyyy-MM-dd")</div>
                <div class="pill">@group.Items.Count session(s)</div>
            </div>

            <div style="margin-top: 12px; display:grid; gap: 10px;">
                @foreach (var s in group.Items)
                {
                    <div class="cardx" style="box-shadow:none; background: color-mix(in oklab, var(--bg), white 4%);">
                        <div class="rowx" style="justify-content: space-between;">
                            <div>
                                <div style="font-weight:850;">@s.NameSnapshot</div>
                                <div class="small">@string.Join(" · ", s.Exercises.Select(e => e.Name))</div>
                            </div>

                            <div class="rowx">
                                <a class="btnx ok" href="@($"/current/{s.Id}")">Open</a>
                                <button class="btnx danger" @onclick="() => DeleteAsync(s.Id)">Delete</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Store.EnsureLoadedAsync();
    }

    private async Task DeleteAsync(Guid sessionId)
    {
        _error = null;
        try { await Store.DeleteSessionAsync(sessionId); }
        catch (Exception ex) { _error = ex.Message; }
    }
}