@page "/current/{SessionId:guid}"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using GymTracker.Models
@using Microsoft.Extensions.Logging
@inject GymTracker.Services.WorkoutStore Store
@inject ILogger<CurrentWorkout> Logger
@inject GymTracker.Services.IToastService Toasts

<PageTitle>Current workout</PageTitle>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="cardx" style="border-color: color-mix(in oklab, var(--danger), transparent 40%);">
        <div style="font-weight:800;">Oops</div>
        <div class="small">@_error</div>
    </div>
}

@if (_editing is null)
{
    <div class="cardx">
        <div style="font-weight:850;">Session not found</div>
        <div class="small">Go to History or Workouts and open a session.</div>
    </div>
}
else
{
    <div class="pagehead">
        <div class="pagehead-left">
            <div class="pagehead-title">@_editing.NameSnapshot</div>
            <div class="pagehead-sub">@_editing.WorkoutDate.ToString("yyyy-MM-dd")</div>
        </div>

        <div class="pagehead-actions">
            <button type="button" class="btnx"
                    @onclick="ToggleShowCompleted"
                    title="Show/hide completed sets">
                @(_showCompleted ? "Hide done" : "Show done")
            </button>

            <span class="badge-live">LIVE</span>
        </div>
    </div>

    <div class="cardx">
        <div class="rowx" style="justify-content: space-between; align-items:flex-end;">
            <div style="flex:1;">
                <label class="small" style="display:block; margin-bottom:8px;">Workout name</label>
                <input class="inputx" @bind="_editing.NameSnapshot" />
            </div>
        </div>

        <div class="rowx" style="margin-top:10px;">
            <span class="pill">Completed: @TotalCompleted / @TotalSets</span>
        </div>
    </div>

    <EditForm Model="_editing" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="stack10" style="margin-top: 12px;">
            @foreach (var ex in _editing.Exercises)
            {
                var isOpen = _openCurrent.Contains(ex.RowId);
                var completedInEx = ex.Sets.Count(s => s.IsCompleted);
                var totalInEx = ex.Sets.Count;

                <div class="excard" @key="ex.RowId">
                    <div class="excard-head" @onclick="() => ToggleCurrent(ex.RowId)">
                        <div class="excard-left">
                            <div class="excard-title">@ex.Name</div>
                            <div class="excard-sub">@totalInEx set(s) · @completedInEx done</div>
                        </div>

                        <div class="excard-actions">
                            <button type="button"
                                    class="btnx ghost"
                                    @onclick="() => AddSet(ex.RowId)"
                                    @onclick:stopPropagation="true">
                                ➕ Set
                            </button>

                            <div class="chev @(isOpen ? "open" : "")">⌄</div>
                        </div>
                    </div>

                    <div class="collapse-grid @(isOpen ? "open" : "")">
                        <div class="collapse-inner">
                            <div class="excard-body">
                                @{
                                    var setsToShow = _showCompleted
                                    ? ex.Sets
                                    : ex.Sets.Where(s => !s.IsCompleted).ToList();
                                }

                                @if (setsToShow.Count == 0)
                                {
                                    <div class="cardx" style="box-shadow:none;">
                                        <div style="font-weight:850;">All sets completed</div>
                                        <div class="small">Turn on “Show done” to see them again.</div>
                                    </div>
                                }
                                else
                                {
                                    <table class="tablex">
                                        <thead>
                                            <tr>
                                                <th class="num">#</th>
                                                <th>Reps</th>
                                                <th>Weight</th>
                                                <th style="width: 190px;"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var row = 0;
                                            }
                                            @foreach (var s in setsToShow)
                                            {
                                                row++;

                                                <tr @key="s.RowId">
                                                    <td class="num">@row</td>
                                                    <td>
                                                        <input class="inputx" style="padding:10px 10px;"
                                                               type="text" inputmode="numeric" pattern="[0-9]*"
                                                               placeholder="10"
                                                               @bind="s.RepsText" @bind:event="oninput" />
                                                    </td>
                                                    <td>
                                                        <input class="inputx" style="padding:10px 10px;"
                                                               type="text" inputmode="decimal"
                                                               placeholder="0"
                                                               @bind="s.WeightText" @bind:event="oninput" />
                                                    </td>
                                                    <td style="text-align:right; display:flex; gap:8px; justify-content:flex-end;">
                                                        <button type="button"
                                                                class="btnx ok"
                                                                style="padding:10px 12px;"
                                                                @onclick="() => ToggleSetCompleted(ex.RowId, s.RowId)"
                                                                title="Mark set done/undo">
                                                            @(s.IsCompleted ? "↩️ Undo" : "✅ Done")
                                                        </button>

                                                        <button type="button"
                                                                class="btnx danger"
                                                                style="padding:10px 12px;"
                                                                @onclick="() => RemoveSet(ex.RowId, s.RowId)"
                                                                disabled="@(ex.Sets.Count <= 1)"
                                                                title="Remove set">
                                                            ✕
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="footer-actions">
            <div class="sticky-bar">
                <div style="flex:1;">
                    <div style="font-weight:850;">Save progress</div>
                </div>

                <button type="submit" class="btnx primary">💾 Save</button>
            </div>
        </div>

    </EditForm>
}

@code {
    [Parameter] public Guid SessionId { get; set; }

    private string? _error;
    private SessionEditModel? _editing;

    private bool _showCompleted;

    private int TotalSets => _editing?.Exercises.Sum(e => e.Sets.Count) ?? 0;
    private int TotalCompleted => _editing?.Exercises.Sum(e => e.Sets.Count(s => s.IsCompleted)) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await Store.EnsureLoadedAsync();

        var s = Store.GetSession(SessionId);
        if (s is null)
        {
            Logger.LogWarning("Current workout session not found. SessionId={SessionId}", SessionId);
            return;
        }

        _editing = SessionEditModel.FromModel(s);

        Logger.LogInformation(
            "Loaded current workout. SessionId={SessionId} DefinitionId={DefinitionId} Date={WorkoutDate}",
            s.Id, s.DefinitionId, s.WorkoutDate);
    }

    private void ToggleShowCompleted()
    {
        _showCompleted = !_showCompleted;

        Logger.LogInformation(
            "Toggled show completed sets. SessionId={SessionId} ShowCompleted={ShowCompleted}",
            SessionId, _showCompleted);
    }

    private void ToggleSetCompleted(Guid exRowId, Guid setRowId)
    {
        if (_editing is null) return;

        var ex = _editing.Exercises.FirstOrDefault(e => e.RowId == exRowId);
        if (ex is null) return;

        var set = ex.Sets.FirstOrDefault(s => s.RowId == setRowId);
        if (set is null) return;

        set.IsCompleted = !set.IsCompleted;

        Logger.LogInformation(
            "Toggled set completion. SessionId={SessionId} Exercise={ExerciseName} SetRowId={SetRowId} IsCompleted={IsCompleted}",
            SessionId, ex.Name, setRowId, set.IsCompleted);
    }

    private void AddSet(Guid exRowId)
    {
        if (_editing is null) return;

        var ex = _editing.Exercises.FirstOrDefault(e => e.RowId == exRowId);
        if (ex is null) return;

        var last = ex.Sets.LastOrDefault();
        ex.Sets.Add(new SetEditModel
        {
            RowId = Guid.NewGuid(),
            RepsText = last?.RepsText ?? "10",
            WeightText = last?.WeightText ?? "0",
            IsCompleted = false
        });

        Logger.LogInformation(
            "Added set. SessionId={SessionId} Exercise={ExerciseName} TotalSets={TotalSets}",
            SessionId, ex.Name, ex.Sets.Count);
    }

    private void RemoveSet(Guid exRowId, Guid setRowId)
    {
        if (_editing is null) return;

        var ex = _editing.Exercises.FirstOrDefault(e => e.RowId == exRowId);
        if (ex is null) return;

        if (ex.Sets.Count <= 1) return;

        var removed = ex.Sets.RemoveAll(s => s.RowId == setRowId) > 0;

        if (removed)
        {
            Logger.LogInformation(
                "Removed set. SessionId={SessionId} Exercise={ExerciseName} RemainingSets={RemainingSets}",
                SessionId, ex.Name, ex.Sets.Count);
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (_editing is null) return;

        try
        {
            var updated = _editing.ToModel();
            await Store.UpdateSessionAsync(updated);
            Toasts.ShowSuccess("Saved");

            Logger.LogInformation(
                "Saved current workout. SessionId={SessionId} Completed={Completed} TotalSets={TotalSets}",
                SessionId, TotalCompleted, TotalSets);
        }
        catch (ValidationException vex)
        {
            _error = vex.Message;
            Logger.LogWarning(vex, "Validation failed saving current workout. SessionId={SessionId}", SessionId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogError(ex, "Unexpected error saving current workout. SessionId={SessionId}", SessionId);
        }
    }

    private sealed class SessionEditModel
    {
        public Guid SessionId { get; set; }
        public Guid DefinitionId { get; set; }
        public DateOnly WorkoutDate { get; set; }

        [Required, StringLength(80)]
        public string NameSnapshot { get; set; } = "Workout";

        [MinLength(1)]
        public List<ExerciseEditModel> Exercises { get; set; } = new();

        public static SessionEditModel FromModel(WorkoutSession s)
            => new()
            {
                SessionId = s.Id,
                DefinitionId = s.DefinitionId,
                WorkoutDate = s.WorkoutDate,
                NameSnapshot = s.NameSnapshot,
                Exercises = s.Exercises.Select(ExerciseEditModel.FromModel).ToList()
            };

        public WorkoutSession ToModel()
        {
            var name = (NameSnapshot ?? "").Trim();
            if (string.IsNullOrWhiteSpace(name))
                throw new ValidationException("Workout name is required.");

            return new WorkoutSession
            {
                Id = SessionId,
                DefinitionId = DefinitionId,
                NameSnapshot = name,
                WorkoutDate = WorkoutDate,
                Exercises = Exercises.Select((e, idx) => e.ToModel(idx + 1)).ToList()
            };
        }
    }

    private sealed class ExerciseEditModel
    {
        public Guid RowId { get; set; } = Guid.NewGuid();
        public string Name { get; set; } = "Exercise";
        public List<SetEditModel> Sets { get; set; } = new() { new SetEditModel() };

        public static ExerciseEditModel FromModel(WorkoutExercise e)
            => new()
            {
                RowId = Guid.NewGuid(),
                Name = e.Name,
                Sets = e.Sets.Select(SetEditModel.FromModel).ToList()
            };

        public WorkoutExercise ToModel(int exNo)
            => new()
            {
                Id = Guid.NewGuid(),
                Name = Name,
                Sets = Sets.Select((s, idx) => s.ToModel(exNo, idx + 1)).ToList()
            };
    }

    private sealed class SetEditModel
    {
        public Guid RowId { get; set; } = Guid.NewGuid();
        public string RepsText { get; set; } = "10";
        public string WeightText { get; set; } = "0";

        public bool IsCompleted { get; set; }

        public static SetEditModel FromModel(ExerciseSet s)
            => new()
            {
                RowId = Guid.NewGuid(),
                RepsText = s.Reps.ToString(CultureInfo.InvariantCulture),
                WeightText = s.Weight.ToString(CultureInfo.InvariantCulture),
                IsCompleted = s.IsCompleted
            };

        public ExerciseSet ToModel(int exNo, int setNo)
        {
            if (!int.TryParse((RepsText ?? "").Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var reps))
                throw new ValidationException($"Exercise {exNo}, set {setNo}: reps must be a whole number.");

            var w = (WeightText ?? "").Trim().Replace(',', '.');
            if (!decimal.TryParse(w, NumberStyles.Number, CultureInfo.InvariantCulture, out var weight))
                throw new ValidationException($"Exercise {exNo}, set {setNo}: weight must be a number.");

            return new ExerciseSet
            {
                Reps = reps,
                Weight = weight,
                IsCompleted = IsCompleted
            };
        }
    }

    private readonly HashSet<Guid> _openCurrent = new();

    private void ToggleCurrent(Guid rowId)
    {
        if (!_openCurrent.Add(rowId))
            _openCurrent.Remove(rowId);
    }
}
