@page "/historyItem/{SessionId:guid}"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using GymTracker.Models
@inject GymTracker.Services.WorkoutStore Store
@inject NavigationManager Nav

<PageTitle>Current workout</PageTitle>

<div style="max-width: 980px; margin: 0 auto; padding: 16px;">
    <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
        <h1 style="margin:0;">Current workout</h1>
        @if (_editing is not null)
        {
            <div style="opacity:.75;">@_editing.WorkoutDate.ToString("yyyy-MM-dd")</div>
        }
        <div style="flex:1;"></div>
        <a class="btn btn-outline-secondary" href="/workouts">Workouts</a>
        <a class="btn btn-outline-secondary" href="/history">History</a>
        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@(_editing is null)">Save</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_info))
    {
        <div style="padding:10px;border:1px solid rgba(0,0,0,.2);border-radius:8px;margin:12px 0;">@_info</div>
    }
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div style="padding:10px;border:1px solid #c33;border-radius:8px;margin:12px 0;">@_error</div>
    }

    @if (_editing is null)
    {
        <p style="opacity:.8;">Workout session not found.</p>
    }
    else
    {
        <EditForm Model="_editing" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div style="display:grid; gap:10px; margin-top:12px;">
                <label>
                    Workout name
                    <InputText class="form-control" @bind-Value="_editing.NameSnapshot" />
                </label>

                @foreach (var ex in _editing.Exercises)
                {
                    <div style="padding: 12px; border: 1px solid rgba(0,0,0,.15); border-radius: 12px;" @key="ex.RowId">
                        <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                            <div style="font-weight:700;">@ex.Name</div>
                            <div style="flex:1;"></div>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AddSet(ex.RowId)">+ Add set</button>
                        </div>

                        <div class="table-responsive" style="margin-top: 8px;">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th style="width:70px;">#</th>
                                        <th style="width:180px;">Reps</th>
                                        <th style="width:220px;">Weight</th>
                                        <th style="width:120px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var row = 0;
                                    }
                                    @foreach (var s in ex.Sets)
                                    {
                                        row++;
                                        <tr @key="s.RowId">
                                            <td>@row</td>
                                            <td><input class="form-control" type="text" inputmode="numeric" pattern="[0-9]*" @bind="s.RepsText" @bind:event="oninput" /></td>
                                            <td><input class="form-control" type="text" inputmode="decimal" @bind="s.WeightText" @bind:event="oninput" /></td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => RemoveSet(ex.RowId, s.RowId)"
                                                        disabled="@(ex.Sets.Count <= 1)">
                                                    Remove
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public Guid SessionId { get; set; }

    private string? _error;
    private string? _info;

    private SessionEditModel? _editing;

    protected override async Task OnInitializedAsync()
    {
        await Store.EnsureLoadedAsync();

        var s = Store.GetSession(SessionId);
        if (s is null) return;

        _editing = SessionEditModel.FromModel(s);
    }

    private void AddSet(Guid exRowId)
    {
        if (_editing is null) return;

        var ex = _editing.Exercises.FirstOrDefault(e => e.RowId == exRowId);
        if (ex is null) return;

        var last = ex.Sets.LastOrDefault();
        ex.Sets.Add(new SetEditModel
        {
            RowId = Guid.NewGuid(),
            RepsText = last?.RepsText ?? "10",
            WeightText = last?.WeightText ?? "0"
        });
    }

    private void RemoveSet(Guid exRowId, Guid setRowId)
    {
        if (_editing is null) return;

        var ex = _editing.Exercises.FirstOrDefault(e => e.RowId == exRowId);
        if (ex is null) return;
        if (ex.Sets.Count <= 1) return;

        ex.Sets.RemoveAll(s => s.RowId == setRowId);
    }

    private async Task SaveAsync()
    {
        _error = null; _info = null;
        if (_editing is null) return;

        try
        {
            var updated = _editing.ToModel();
            await Store.UpdateSessionAsync(updated);
            _info = "Saved.";
        }
        catch (ValidationException vex) { _error = vex.Message; }
        catch (Exception ex) { _error = ex.Message; }
    }

    private sealed class SessionEditModel
    {
        public Guid SessionId { get; set; }
        public Guid DefinitionId { get; set; }
        public DateOnly WorkoutDate { get; set; }

        [Required, StringLength(80)]
        public string NameSnapshot { get; set; } = "Workout";

        [MinLength(1)]
        public List<ExerciseEditModel> Exercises { get; set; } = new();

        public static SessionEditModel FromModel(WorkoutSession s)
            => new()
            {
                SessionId = s.Id,
                DefinitionId = s.DefinitionId,
                WorkoutDate = s.WorkoutDate,
                NameSnapshot = s.NameSnapshot,
                Exercises = s.Exercises.Select(ExerciseEditModel.FromModel).ToList()
            };

        public WorkoutSession ToModel()
        {
            var name = (NameSnapshot ?? "").Trim();
            if (string.IsNullOrWhiteSpace(name))
                throw new ValidationException("Workout name is required.");

            var ex = Exercises.Select((e, idx) => e.ToModel(idx + 1)).ToList();

            return new WorkoutSession
            {
                Id = SessionId,
                DefinitionId = DefinitionId,
                NameSnapshot = name,
                WorkoutDate = WorkoutDate,
                Exercises = ex
            };
        }
    }

    private sealed class ExerciseEditModel
    {
        public Guid RowId { get; set; } = Guid.NewGuid();
        public string Name { get; set; } = "Exercise";
        public List<SetEditModel> Sets { get; set; } = new() { new SetEditModel() };

        public static ExerciseEditModel FromModel(WorkoutExercise e)
            => new()
            {
                RowId = Guid.NewGuid(),
                Name = e.Name,
                Sets = e.Sets.Select(SetEditModel.FromModel).ToList()
            };

        public WorkoutExercise ToModel(int exNo)
        {
            var sets = Sets.Select((s, idx) => s.ToModel(exNo, idx + 1)).ToList();

            return new WorkoutExercise
            {
                Id = Guid.NewGuid(),
                Name = Name,
                Sets = sets
            };
        }
    }

    private sealed class SetEditModel
    {
        public Guid RowId { get; set; } = Guid.NewGuid();
        public string RepsText { get; set; } = "10";
        public string WeightText { get; set; } = "0";

        public static SetEditModel FromModel(ExerciseSet s)
            => new()
            {
                RowId = Guid.NewGuid(),
                RepsText = s.Reps.ToString(CultureInfo.InvariantCulture),
                WeightText = s.Weight.ToString(CultureInfo.InvariantCulture)
            };

        public ExerciseSet ToModel(int exNo, int setNo)
        {
            if (!int.TryParse((RepsText ?? "").Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var reps))
                throw new ValidationException($"Exercise {exNo}, set {setNo}: reps must be a whole number.");

            var w = (WeightText ?? "").Trim().Replace(',', '.');
            if (!decimal.TryParse(w, NumberStyles.Number, CultureInfo.InvariantCulture, out var weight))
                throw new ValidationException($"Exercise {exNo}, set {setNo}: weight must be a number.");

            return new ExerciseSet { Reps = reps, Weight = weight };
        }
    }
}