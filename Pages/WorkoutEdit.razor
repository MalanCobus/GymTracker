@page "/workouts/{DefinitionId:guid}"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using GymTracker.Models
@inject GymTracker.Services.WorkoutStore Store
@inject NavigationManager Nav

<PageTitle>Edit Workout</PageTitle>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="cardx" style="border-color: color-mix(in oklab, var(--danger), transparent 40%);">
        <div style="font-weight:850;">Oops</div>
        <div class="small">@_error</div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_info))
{
    <div class="cardx" style="border-color: color-mix(in oklab, var(--ok), transparent 40%);">
        <div style="font-weight:850;">@_info</div>
    </div>
}

@if (_editing is null)
{
    <div class="cardx">
        <div style="font-weight:850;">Workout not found</div>
        <div class="small">Go back to Workouts and pick one.</div>
        <div style="margin-top: 12px;">
            <a class="btnx" href="workouts">← Back</a>
        </div>
    </div>
}
else
{
    <div class="rowx" style="justify-content: space-between;">
        <div>
            <div class="title">Edit workout</div>
            <div class="kicker">Build your template (no dates). “Do workout” creates a dated session.</div>
        </div>
        <a class="btnx" href="workouts">← Back</a>
    </div>

    <EditForm id="editForm" Model="_editing" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="cardx" style="margin-top: 12px;">
            <label class="small" style="display:block; margin-bottom: 8px;">Workout name</label>
            <InputText class="inputx" @bind-Value="_editing.Name" />
        </div>

        <div class="cardx">
            <div class="rowx" style="justify-content: space-between;">
                <div>
                    <div style="font-weight:850;">Exercises</div>
                    <div class="small">Tap an exercise to expand sets.</div>
                </div>

                <button type="button" class="btnx primary" @onclick="AddExercise">➕ Add</button>
            </div>
        </div>

        <div class="accordionx" style="margin-top: 12px;">
            @foreach (var ex in _editing.Exercises)
            {
                <details open @key="ex.RowId">
                    <summary>
                        <div class="sumrow">
                            <div class="left">
                                <div style="font-weight:850;">@(string.IsNullOrWhiteSpace(ex.Name) ? "Exercise" : ex.Name)</div>
                                <div class="small">@ex.Sets.Count set(s)</div>
                            </div>
                            <div class="right">
                                <button type="button" class="btnx ghost" @onclick="() => AddSet(ex.RowId)">➕ Set</button>
                                <button type="button"
                                        class="btnx danger"
                                        @onclick="() => RemoveExercise(ex.RowId)"
                                        disabled="@(_editing.Exercises.Count <= 1)">
                                    ✕
                                </button>
                            </div>
                        </div>
                    </summary>

                    <div style="margin-top: 10px;">
                        <label class="small" style="display:block; margin-bottom: 8px;">Exercise name</label>
                        <input class="inputx"
                               type="text"
                               placeholder="e.g. Bench Press"
                               @bind="ex.Name"
                               @bind:event="oninput" />

                        <hr class="sep" />

                        <table class="tablex">
                            <thead>
                                <tr>
                                    <th class="num">#</th>
                                    <th>Reps</th>
                                    <th>Weight</th>
                                    <th style="width: 92px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var row = 0;
                                }
                                @foreach (var s in ex.Sets)
                                {
                                    row++;
                                    <tr @key="s.RowId">
                                        <td class="num">@row</td>
                                        <td>
                                            <input class="inputx" style="padding:10px 10px;"
                                                   type="text" inputmode="numeric" pattern="[0-9]*"
                                                   @bind="s.RepsText" @bind:event="oninput" />
                                        </td>
                                        <td>
                                            <input class="inputx" style="padding:10px 10px;"
                                                   type="text" inputmode="decimal"
                                                   @bind="s.WeightText" @bind:event="oninput" />
                                        </td>
                                        <td style="text-align:right;">
                                            <button type="button"
                                                    class="btnx danger"
                                                    style="padding:10px 12px;"
                                                    @onclick="() => RemoveSet(ex.RowId, s.RowId)"
                                                    disabled="@(ex.Sets.Count <= 1)">
                                                ✕
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
        </div>

        <div style="height: 104px;"></div> @* spacer so content doesn't hide behind sticky bar *@

        <div class="sticky-actions">
            <div class="sticky-actions-inner">
                <div class="sticky-bar">
                    <div style="flex:1;">
                        <div style="font-weight:850;">Actions</div>
                        <div class="small">Save updates or start today’s session.</div>
                    </div>

                    <button type="button" class="btnx ok" @onclick="DoWorkoutAsync">▶️ Do workout</button>
                    <button type="submit" class="btnx primary">💾 Save</button>
                </div>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter] public Guid DefinitionId { get; set; }

    private string? _error;
    private string? _info;

    private DefinitionEditModel? _editing;

    protected override async Task OnInitializedAsync()
    {
        await Store.EnsureLoadedAsync();

        var d = Store.GetDefinition(DefinitionId);
        if (d is null) return;

        _editing = DefinitionEditModel.FromModel(d);
    }

    private void AddExercise()
    {
        if (_editing is null) return;

        _editing.Exercises.Add(new ExerciseEditModel
        {
            RowId = Guid.NewGuid(),
            Name = "",
            Sets = new List<SetEditModel> { new() }
        });
    }

    private void RemoveExercise(Guid rowId)
    {
        if (_editing is null) return;
        if (_editing.Exercises.Count <= 1) return;
        _editing.Exercises.RemoveAll(e => e.RowId == rowId);
    }

    private void AddSet(Guid exRowId)
    {
        if (_editing is null) return;

        var ex = _editing.Exercises.FirstOrDefault(e => e.RowId == exRowId);
        if (ex is null) return;

        var last = ex.Sets.LastOrDefault();
        ex.Sets.Add(new SetEditModel
        {
            RowId = Guid.NewGuid(),
            RepsText = last?.RepsText ?? "10",
            WeightText = last?.WeightText ?? "0"
        });
    }

    private void RemoveSet(Guid exRowId, Guid setRowId)
    {
        if (_editing is null) return;

        var ex = _editing.Exercises.FirstOrDefault(e => e.RowId == exRowId);
        if (ex is null) return;
        if (ex.Sets.Count <= 1) return;

        ex.Sets.RemoveAll(s => s.RowId == setRowId);
    }

    private async Task SaveAsync()
    {
        _error = null; _info = null;
        if (_editing is null) return;

        try
        {
            var updated = _editing.ToModel();
            await Store.UpdateDefinitionAsync(updated);
            _info = "Saved.";
        }
        catch (ValidationException vex) { _error = vex.Message; }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task DoWorkoutAsync()
    {
        _error = null; _info = null;
        if (_editing is null) return;

        try
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var session = await Store.StartWorkoutAsync(_editing.DefinitionId, today);

            // IMPORTANT: route should be /current/{sessionId}
            Nav.NavigateTo($"current/{session.Id}");
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private sealed class DefinitionEditModel
    {
        public Guid DefinitionId { get; set; }

        [Required, StringLength(80)]
        public string Name { get; set; } = "Workout";

        [MinLength(1)]
        public List<ExerciseEditModel> Exercises { get; set; } = new();

        public static DefinitionEditModel FromModel(WorkoutDefinition d)
            => new()
            {
                DefinitionId = d.Id,
                Name = d.Name,
                Exercises = d.Exercises.Select(ExerciseEditModel.FromModel).ToList()
            };

        public WorkoutDefinition ToModel()
        {
            var name = (Name ?? "").Trim();
            if (string.IsNullOrWhiteSpace(name))
                throw new ValidationException("Workout name is required.");

            var ex = Exercises.Select((e, idx) => e.ToModel(idx + 1)).ToList();
            if (ex.Count == 0)
                throw new ValidationException("Add at least one exercise.");

            return new WorkoutDefinition
            {
                Id = DefinitionId,
                Name = name,
                Exercises = ex
            };
        }
    }

    private sealed class ExerciseEditModel
    {
        public Guid RowId { get; set; } = Guid.NewGuid();
        public string Name { get; set; } = "";
        public List<SetEditModel> Sets { get; set; } = new() { new SetEditModel() };

        public static ExerciseEditModel FromModel(WorkoutExercise e)
            => new()
            {
                RowId = Guid.NewGuid(),
                Name = e.Name,
                Sets = e.Sets.Select(SetEditModel.FromModel).ToList()
            };

        public WorkoutExercise ToModel(int exNo)
        {
            var n = (Name ?? "").Trim();
            if (string.IsNullOrWhiteSpace(n))
                throw new ValidationException($"Exercise {exNo}: name is required.");

            return new WorkoutExercise
            {
                Id = Guid.NewGuid(),
                Name = n,
                Sets = Sets.Select((s, idx) => s.ToModel(exNo, idx + 1)).ToList()
            };
        }
    }

    private sealed class SetEditModel
    {
        public Guid RowId { get; set; } = Guid.NewGuid();
        public string RepsText { get; set; } = "10";
        public string WeightText { get; set; } = "0";

        public static SetEditModel FromModel(ExerciseSet s)
            => new()
            {
                RowId = Guid.NewGuid(),
                RepsText = s.Reps.ToString(CultureInfo.InvariantCulture),
                WeightText = s.Weight.ToString(CultureInfo.InvariantCulture)
            };

        public ExerciseSet ToModel(int exNo, int setNo)
        {
            if (!int.TryParse((RepsText ?? "").Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var reps))
                throw new ValidationException($"Exercise {exNo}, set {setNo}: reps must be a whole number.");

            var w = (WeightText ?? "").Trim().Replace(',', '.');
            if (!decimal.TryParse(w, NumberStyles.Number, CultureInfo.InvariantCulture, out var weight))
                throw new ValidationException($"Exercise {exNo}, set {setNo}: weight must be a number.");

            return new ExerciseSet { Reps = reps, Weight = weight };
        }
    }
}
