@page "/workouts/new"
@page "/workouts/{DefinitionId:guid}"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using GymTracker.Models
@using Microsoft.Extensions.Logging
@inject GymTracker.Services.WorkoutStore Store
@inject NavigationManager Nav
@inject ILogger<WorkoutEdit> Logger

<PageTitle>Edit Workout</PageTitle>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="cardx" style="border-color: color-mix(in oklab, var(--danger), transparent 40%);">
        <div style="font-weight:850;">Oops</div>
        <div class="small">@_error</div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_info))
{
    <div class="cardx" style="border-color: color-mix(in oklab, var(--ok), transparent 40%);">
        <div style="font-weight:850;">@_info</div>
    </div>
}

@if (_editing is null)
{
    <div class="pagehead">
        <div class="pagehead-left">
            <div class="pagehead-title">Workout not found</div>
            <div class="pagehead-sub">Go back to Workouts and pick one.</div>
        </div>

        <div class="pagehead-actions">
            <a class="btnx" href="/workouts">← Back</a>
        </div>
    </div>

    <div class="cardx">
        <div style="font-weight:850;">Nothing to edit</div>
        <div class="small">The workout may have been deleted or the link is invalid.</div>
    </div>
}
else
{
    <div class="pagehead">
        <div class="pagehead-left">
            <div class="pagehead-title">@(_isNew ? "New workout" : "Edit workout")</div>
        </div>

        <div class="pagehead-actions">
            <span class="pill">@(_isNew ? "Draft" : "Saved")</span>
            <a class="btnx" href="/workouts">← Back</a>
        </div>
    </div>

    <EditForm id="editForm" Model="_editing" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="cardx" style="margin-top: 12px;">
            <label class="small" style="display:block; margin-bottom: 8px;">Workout name</label>
            <InputText class="inputx" placeholder="e.g. Push Day" @bind-Value="_editing.Name" />
        </div>

        <div class="cardx" style="margin-top: 12px;">
            <div class="rowx" style="justify-content: space-between;">
                <div>
                    <div style="font-weight:850;">Exercises</div>
                    <div class="small">Add exercises, then expand to edit sets.</div>
                </div>
                <button type="button" class="btnx primary" @onclick="OpenAddExerciseModal">➕ Add exercise</button>
            </div>
        </div>

        @* --- Exercises list (collapsible) --- *@
        @if (_editing.Exercises.Count == 0)
        {
            <div class="cardx">
                <div style="font-weight:850;">No exercises yet</div>
                <div class="small">Tap “Add exercise” to start building this workout.</div>
            </div>
        }
        else
        {
            <div class="stack10" style="margin-top: 10px;">
                @foreach (var ex in _editing.Exercises)
                {
                    var isOpen = _openExercises.Contains(ex.RowId);

                    <div class="excard" @key="ex.RowId">
                        <div class="excard-head" @onclick="() => ToggleExercise(ex.RowId)">
                            <div class="excard-left">
                                <div class="excard-title">
                                    @(string.IsNullOrWhiteSpace(ex.Name) ? "Untitled exercise" : ex.Name)
                                </div>
                                <div class="excard-sub">@ex.Sets.Count set(s)</div>
                            </div>

                            <div class="excard-actions">
                                <button type="button"
                                        class="btnx ghost"
                                        @onclick="() => AddSet(ex.RowId)"
                                        @onclick:stopPropagation="true">
                                    ➕ Set
                                </button>

                                <button type="button"
                                        class="btnx danger"
                                        @onclick="() => RemoveExercise(ex.RowId)"
                                        @onclick:stopPropagation="true"
                                        title="Remove exercise">
                                    ✕
                                </button>

                                <div class="chev @(isOpen ? "open" : "")">⌄</div>
                            </div>
                        </div>

                        <div class="collapse-grid @(isOpen ? "open" : "")">
                            <div class="collapse-inner">
                                <div class="excard-body">
                                    <label class="small" style="display:block; margin-bottom: 8px;">Exercise name</label>
                                    <input class="inputx"
                                           type="text"
                                           placeholder="e.g. Bench Press"
                                           @bind="ex.Name"
                                           @bind:event="oninput" />

                                    <hr class="sep" />

                                    @if (ex.Sets.Count == 0)
                                    {
                                        <div class="cardx" style="box-shadow:none;">
                                            <div style="font-weight:850;">No sets yet</div>
                                            <div class="small">Tap “+ Set”.</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <table class="tablex">
                                            <thead>
                                                <tr>
                                                    <th class="num">#</th>
                                                    <th>Reps</th>
                                                    <th>Weight</th>
                                                    <th style="width: 92px;"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{
                                                    var row = 0;
                                                }
                                                @foreach (var s in ex.Sets)
                                                {
                                                    row++;
                                                    <tr @key="s.RowId">
                                                        <td class="num">@row</td>
                                                        <td>
                                                            <input class="inputx" style="padding:10px 10px;"
                                                                   type="text" inputmode="numeric" pattern="[0-9]*"
                                                                   placeholder="10"
                                                                   @bind="s.RepsText" @bind:event="oninput" />
                                                        </td>
                                                        <td>
                                                            <input class="inputx" style="padding:10px 10px;"
                                                                   type="text" inputmode="decimal"
                                                                   placeholder="0"
                                                                   @bind="s.WeightText" @bind:event="oninput" />
                                                        </td>
                                                        <td style="text-align:right;">
                                                            <button type="button"
                                                                    class="btnx danger"
                                                                    style="padding:10px 12px;"
                                                                    @onclick="() => RemoveSet(ex.RowId, s.RowId)"
                                                                    disabled="@(ex.Sets.Count <= 1)"
                                                                    title="Remove set">
                                                                ✕
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="footer-actions">
            <div class="sticky-bar">
                <div style="flex:1;">
                    <div style="font-weight:850;">Actions</div>
                    <div class="small">@(_isNew ? "Save first, then you can start the workout." : "Save changes or start today.")</div>
                </div>

                <button type="button" class="btnx ok" @onclick="DoWorkoutAsync" disabled="@_isNew">▶️ Do workout</button>
                <button type="submit" class="btnx primary">💾 Save</button>
            </div>
        </div>
    </EditForm>
}

@if (_showAddExerciseModal)
{
    <div class="modal-backdrop" @onclick="CloseAddExerciseModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-head">
                <div>
                    <div style="font-weight:900;">Add exercise</div>
                    <div class="small">Leave reps/weight blank to default to 10 and 0.</div>
                </div>
                <button type="button" class="btnx danger" style="padding:10px 12px;" @onclick="CloseAddExerciseModal">✕</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrWhiteSpace(_modalError))
                {
                    <div class="cardx" style="box-shadow:none; border-color: color-mix(in oklab, var(--danger), transparent 40%);">
                        <div class="small">@_modalError</div>
                    </div>
                }

                <div style="margin-top: 10px;">
                    <label class="small" style="display:block; margin-bottom: 8px;">Exercise name</label>
                    <input class="inputx" placeholder="e.g. Squat" @bind="_newExerciseName" @bind:event="oninput" />
                </div>

                <div class="grid2" style="margin-top: 10px;">
                    <div>
                        <label class="small" style="display:block; margin-bottom: 8px;">Sets</label>
                        <input class="inputx" placeholder="3" type="text" inputmode="numeric" pattern="[0-9]*"
                               @bind="_newSetsText" @bind:event="oninput" />
                    </div>

                    <div>
                        <label class="small" style="display:block; margin-bottom: 8px;">Default reps</label>
                        <input class="inputx" placeholder="10" type="text" inputmode="numeric" pattern="[0-9]*"
                               @bind="_newRepsText" @bind:event="oninput" />
                    </div>

                    <div>
                        <label class="small" style="display:block; margin-bottom: 8px;">Default weight</label>
                        <input class="inputx" placeholder="0" type="text" inputmode="decimal"
                               @bind="_newWeightText" @bind:event="oninput" />
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btnx" @onclick="CloseAddExerciseModal">Cancel</button>
                <button type="button" class="btnx primary" @onclick="ConfirmAddExercise">Add</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid DefinitionId { get; set; } // Guid.Empty when using /workouts/new

    private string? _error;
    private string? _info;

    private bool _isNew;
    private DefinitionEditModel? _editing;

    private bool _showAddExerciseModal;
    private string? _modalError;

    private string _newExerciseName = "";
    private string _newSetsText = "";
    private string _newRepsText = "";
    private string _newWeightText = "";

    protected override async Task OnInitializedAsync()
    {
        await Store.EnsureLoadedAsync();

        _isNew = DefinitionId == Guid.Empty;

        if (_isNew)
        {
            _editing = new DefinitionEditModel
            {
                DefinitionId = Guid.Empty,
                Name = "",
                Exercises = new List<ExerciseEditModel>()
            };

            Logger.LogInformation("Opened new workout editor (draft).");
            return;
        }

        var d = Store.GetDefinition(DefinitionId);
        if (d is null)
        {
            Logger.LogWarning("Workout definition not found. DefinitionId={DefinitionId}", DefinitionId);
            return;
        }

        _editing = DefinitionEditModel.FromModel(d);

        Logger.LogInformation(
            "Loaded workout definition for edit. DefinitionId={DefinitionId} Name={Name} Exercises={ExerciseCount}",
            d.Id, d.Name, d.Exercises?.Count ?? 0);
    }

    private void OpenAddExerciseModal()
    {
        _modalError = null;
        _newExerciseName = "";
        _newSetsText = "";
        _newRepsText = "";
        _newWeightText = "";
        _showAddExerciseModal = true;

        Logger.LogInformation("Opened add-exercise modal. DefinitionId={DefinitionId} IsNew={IsNew}", DefinitionId, _isNew);
    }

    private void CloseAddExerciseModal()
    {
        _showAddExerciseModal = false;
        _modalError = null;

        Logger.LogInformation("Closed add-exercise modal. DefinitionId={DefinitionId}", DefinitionId);
    }

    private void ConfirmAddExercise()
    {
        if (_editing is null) return;

        _modalError = null;

        var name = (_newExerciseName ?? "").Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            _modalError = "Exercise name is required.";
            Logger.LogWarning("Add-exercise failed validation: empty name. DefinitionId={DefinitionId}", DefinitionId);
            return;
        }

        var setsCount = ParseOrDefaultInt(_newSetsText, 3);
        if (setsCount < 1 || setsCount > 20)
        {
            _modalError = "Sets must be between 1 and 20.";
            Logger.LogWarning("Add-exercise failed validation: invalid sets count. DefinitionId={DefinitionId} SetsCount={SetsCount}", DefinitionId, setsCount);
            return;
        }

        var reps = ParseOrDefaultInt(_newRepsText, 10);
        if (reps < 0 || reps > 500)
        {
            _modalError = "Default reps must be 0–500.";
            Logger.LogWarning("Add-exercise failed validation: invalid reps. DefinitionId={DefinitionId} Reps={Reps}", DefinitionId, reps);
            return;
        }

        var weight = ParseOrDefaultDecimal(_newWeightText, 0m);
        if (weight < 0 || weight > 2000)
        {
            _modalError = "Default weight must be 0–2000.";
            Logger.LogWarning("Add-exercise failed validation: invalid weight. DefinitionId={DefinitionId} Weight={Weight}", DefinitionId, weight);
            return;
        }

        var sets = new List<SetEditModel>(setsCount);
        for (var i = 0; i < setsCount; i++)
        {
            sets.Add(new SetEditModel
            {
                RowId = Guid.NewGuid(),
                RepsText = string.IsNullOrWhiteSpace(_newRepsText) ? "" : reps.ToString(CultureInfo.InvariantCulture),
                WeightText = string.IsNullOrWhiteSpace(_newWeightText) ? "" : weight.ToString(CultureInfo.InvariantCulture)
            });
        }

        _editing.Exercises.Add(new ExerciseEditModel
        {
            RowId = Guid.NewGuid(),
            Name = name,
            Sets = sets
        });

        _showAddExerciseModal = false;

        Logger.LogInformation(
            "Added exercise to draft. DefinitionId={DefinitionId} ExerciseName={ExerciseName} Sets={Sets} TotalExercises={TotalExercises}",
            DefinitionId, name, setsCount, _editing.Exercises.Count);
    }

    private void RemoveExercise(Guid rowId)
    {
        if (_editing is null) return;

        var removed = _editing.Exercises.RemoveAll(e => e.RowId == rowId) > 0;
        if (removed)
        {
            Logger.LogInformation(
                "Removed exercise from draft. DefinitionId={DefinitionId} ExerciseRowId={ExerciseRowId} RemainingExercises={RemainingExercises}",
                DefinitionId, rowId, _editing.Exercises.Count);
        }
    }

    private void AddSet(Guid exRowId)
    {
        if (_editing is null) return;

        var ex = _editing.Exercises.FirstOrDefault(e => e.RowId == exRowId);
        if (ex is null) return;

        var last = ex.Sets.LastOrDefault();
        ex.Sets.Add(new SetEditModel
        {
            RowId = Guid.NewGuid(),
            RepsText = last?.RepsText ?? "",
            WeightText = last?.WeightText ?? ""
        });

        Logger.LogInformation(
            "Added set to exercise. DefinitionId={DefinitionId} ExerciseName={ExerciseName} TotalSets={TotalSets}",
            DefinitionId, ex.Name, ex.Sets.Count);
    }

    private void RemoveSet(Guid exRowId, Guid setRowId)
    {
        if (_editing is null) return;

        var ex = _editing.Exercises.FirstOrDefault(e => e.RowId == exRowId);
        if (ex is null) return;

        if (ex.Sets.Count <= 1) return;

        var removed = ex.Sets.RemoveAll(s => s.RowId == setRowId) > 0;
        if (removed)
        {
            Logger.LogInformation(
                "Removed set from exercise. DefinitionId={DefinitionId} ExerciseName={ExerciseName} RemainingSets={RemainingSets}",
                DefinitionId, ex.Name, ex.Sets.Count);
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        _info = null;
        if (_editing is null) return;

        try
        {
            var def = _editing.ToModel();

            var saved = await Store.UpsertDefinitionAsync(def);

            _info = "Saved.";

            Logger.LogInformation(
                "Saved workout definition. DefinitionId={DefinitionId} Name={Name} Exercises={ExerciseCount} WasNew={WasNew}",
                saved.Id, saved.Name, saved.Exercises?.Count ?? 0, _isNew);

            if (_isNew)
            {
                _isNew = false;
                DefinitionId = saved.Id;

                Nav.NavigateTo($"/workouts/{saved.Id}", replace: true);
                Logger.LogInformation("Replaced URL after first save. DefinitionId={DefinitionId}", saved.Id);
            }
        }
        catch (ValidationException vex)
        {
            _error = vex.Message;
            Logger.LogWarning(vex, "Validation failed saving workout definition. DefinitionId={DefinitionId} IsNew={IsNew}", DefinitionId, _isNew);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogError(ex, "Unexpected error saving workout definition. DefinitionId={DefinitionId} IsNew={IsNew}", DefinitionId, _isNew);
        }
    }

    private async Task DoWorkoutAsync()
    {
        _error = null;
        _info = null;

        if (_isNew)
        {
            _error = "Save the workout first.";
            Logger.LogWarning("Attempted to start workout from unsaved draft.");
            return;
        }

        if (_editing is null) return;

        try
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var session = await Store.StartWorkoutAsync(_editing.DefinitionId, today);

            Logger.LogInformation(
                "Started workout session. DefinitionId={DefinitionId} SessionId={SessionId} Date={WorkoutDate}",
                _editing.DefinitionId, session.Id, session.WorkoutDate);

            Nav.NavigateTo($"/current/{session.Id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogError(ex, "Failed to start workout session. DefinitionId={DefinitionId}", _editing.DefinitionId);
        }
    }

    private static int ParseOrDefaultInt(string? text, int fallback)
        => int.TryParse((text ?? "").Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v) ? v : fallback;

    private static decimal ParseOrDefaultDecimal(string? text, decimal fallback)
    {
        var t = (text ?? "").Trim().Replace(',', '.');
        return decimal.TryParse(t, NumberStyles.Number, CultureInfo.InvariantCulture, out var v) ? v : fallback;
    }

    private sealed class DefinitionEditModel
    {
        public Guid DefinitionId { get; set; }
        public string Name { get; set; } = "";
        public List<ExerciseEditModel> Exercises { get; set; } = new();

        public static DefinitionEditModel FromModel(WorkoutDefinition d)
            => new()
            {
                DefinitionId = d.Id,
                Name = d.Name ?? "",
                Exercises = d.Exercises.Select(ExerciseEditModel.FromModel).ToList()
            };

        public WorkoutDefinition ToModel()
        {
            var name = (Name ?? "").Trim();
            if (string.IsNullOrWhiteSpace(name))
                throw new ValidationException("Workout name is required.");

            if (Exercises.Count == 0)
                throw new ValidationException("Add at least one exercise.");

            return new WorkoutDefinition
            {
                Id = DefinitionId,
                Name = name,
                Exercises = Exercises.Select((e, idx) => e.ToModel(idx + 1)).ToList()
            };
        }
    }

    private sealed class ExerciseEditModel
    {
        public Guid RowId { get; set; } = Guid.NewGuid();
        public string Name { get; set; } = "";
        public List<SetEditModel> Sets { get; set; } = new();

        public static ExerciseEditModel FromModel(WorkoutExercise e)
            => new()
            {
                RowId = Guid.NewGuid(),
                Name = e.Name ?? "",
                Sets = e.Sets.Select(SetEditModel.FromModel).ToList()
            };

        public WorkoutExercise ToModel(int exNo)
        {
            var n = (Name ?? "").Trim();
            if (string.IsNullOrWhiteSpace(n))
                throw new ValidationException($"Exercise {exNo}: name is required.");

            if (Sets.Count == 0)
                throw new ValidationException($"Exercise {exNo}: add at least one set.");

            return new WorkoutExercise
            {
                Id = Guid.NewGuid(),
                Name = n,
                Sets = Sets.Select((s, idx) => s.ToModel(exNo, idx + 1)).ToList()
            };
        }
    }

    private sealed class SetEditModel
    {
        public Guid RowId { get; set; } = Guid.NewGuid();
        public string RepsText { get; set; } = "";
        public string WeightText { get; set; } = "";

        public static SetEditModel FromModel(ExerciseSet s)
            => new()
            {
                RowId = Guid.NewGuid(),
                RepsText = s.Reps.ToString(CultureInfo.InvariantCulture),
                WeightText = s.Weight.ToString(CultureInfo.InvariantCulture)
            };

        public ExerciseSet ToModel(int exNo, int setNo)
        {
            var reps = string.IsNullOrWhiteSpace(RepsText)
                ? 10
                : ParseInt(RepsText, $"Exercise {exNo}, set {setNo}: reps must be a whole number.");

            var weight = string.IsNullOrWhiteSpace(WeightText)
                ? 0m
                : ParseDecimal(WeightText, $"Exercise {exNo}, set {setNo}: weight must be a number.");

            return new ExerciseSet { Reps = reps, Weight = weight };
        }

        private static int ParseInt(string text, string err)
            => int.TryParse(text.Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v)
                ? v
                : throw new ValidationException(err);

        private static decimal ParseDecimal(string text, string err)
        {
            var t = text.Trim().Replace(',', '.');
            return decimal.TryParse(t, NumberStyles.Number, CultureInfo.InvariantCulture, out var v)
                ? v
                : throw new ValidationException(err);
        }
    }

    private readonly HashSet<Guid> _openExercises = new();

    private void ToggleExercise(Guid rowId)
    {
        if (!_openExercises.Add(rowId))
            _openExercises.Remove(rowId);
    }
}
