@page "/"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using GymTracker.Models
@inject GymTracker.Services.WorkoutStore Store

<PageTitle>GymTracker</PageTitle>

<div style="max-width: 980px; margin: 0 auto; padding: 16px;">
    <h1 style="margin-bottom: 6px;">GymTracker</h1>
    <p style="margin-top: 0; opacity: 0.8;">Groups (sessions) per day. Save groups as templates and reload them.</p>

    @if (!string.IsNullOrWhiteSpace(_info))
    {
        <div style="padding: 10px; border: 1px solid rgba(0,0,0,.2); border-radius: 8px; margin: 12px 0;">
            @_info
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div style="padding: 10px; border: 1px solid #c33; border-radius: 8px; margin: 12px 0;">
            @_error
        </div>
    }

    <div style="display:grid; gap: 16px; grid-template-columns: 1fr;">
        <div style="display:flex; gap: 12px; align-items:end; flex-wrap: wrap;">
            <label style="min-width: 220px;">
                Date
                <InputDate class="form-control" @bind-Value="_selectedDate" />
            </label>

            <label style="min-width: 260px;">
                New group name
                <InputText class="form-control" @bind-Value="_newGroupName" />
            </label>

            <button class="btn btn-primary" @onclick="CreateGroupAsync">+ Create group</button>

            <div style="flex:1;"></div>

            <label style="min-width: 260px;">
                Load template
                <select class="form-select" @bind="_selectedTemplateId">
                    <option value="">-- select --</option>
                    @foreach (var t in Store.Templates)
                    {
                        <option value="@t.Id.ToString()">@t.Name</option>
                    }
                </select>
            </label>

            <button class="btn btn-outline-primary" @onclick="AddFromTemplateAsync" disabled="@string.IsNullOrWhiteSpace(_selectedTemplateId)">
                + Add group from template
            </button>
        </div>

        <hr />

        <h3 style="margin:0;">Groups on @SelectedDateOnly.ToString("yyyy-MM-dd") (@GroupsForSelectedDate.Count)</h3>

        @if (GroupsForSelectedDate.Count == 0)
        {
            <p style="opacity:0.8;">No groups yet for this day.</p>
        }
        else
        {
            <div style="display:grid; gap: 10px;">
                @foreach (var g in GroupsForSelectedDate)
                {
                    <div style="padding: 12px; border: 1px solid rgba(0,0,0,.15); border-radius: 12px;">
                        <div style="display:flex; gap: 10px; align-items:center; flex-wrap:wrap;">
                            <div style="font-weight:700; font-size: 1.05em;">@g.Name</div>
                            <div style="opacity:.75;">(@g.Exercises.Count exercise(s))</div>

                            <div style="flex:1;"></div>

                            <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEditGroup(g.Id)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteGroupAsync(g.Id)">Delete</button>
                        </div>

                        <div style="opacity:.85; margin-top: 6px;">
                            @RenderGroupSummary(g)
                        </div>
                    </div>
                }
            </div>
        }

        <hr />

        <h3 style="margin:0;">Templates (@Store.Templates.Count)</h3>
        @if (Store.Templates.Count == 0)
        {
            <p style="opacity:0.8;">No templates yet. Edit a group and click “Save as template”.</p>
        }
        else
        {
            <div style="display:grid; gap: 10px;">
                @foreach (var t in Store.Templates)
                {
                    <div style="padding: 12px; border: 1px solid rgba(0,0,0,.15); border-radius: 12px;">
                        <div style="display:flex; gap: 10px; align-items:center; flex-wrap:wrap;">
                            <div style="font-weight:700;">@t.Name</div>
                            <div style="opacity:.75;">(@t.Exercises.Count exercise(s))</div>

                            <div style="flex:1;"></div>

                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTemplateAsync(t.Id)">Delete</button>
                        </div>

                        <div style="opacity:.85; margin-top: 6px;">
                            @string.Join(" · ", t.Exercises.Select(e => e.Name))
                        </div>
                    </div>
                }
            </div>
        }

        <hr />

        <h3 style="margin:0;">Edit group</h3>

        @if (_editing is null)
        {
            <p style="opacity:0.8;">Select a group and click “Edit”.</p>
        }
        else
        {
            <EditForm Model="_editing" OnValidSubmit="SaveEditedGroupAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div style="display:grid; gap: 10px; grid-template-columns: 1fr;">
                    <label>
                        Group name
                        <InputText class="form-control" @bind-Value="_editing.Name" />
                    </label>

                    <div style="display:flex; gap: 10px; align-items:end; flex-wrap:wrap;">
                        <label style="min-width: 260px;">
                            Save as template name
                            <InputText class="form-control" @bind-Value="_templateName" />
                        </label>
                        <button type="button" class="btn btn-outline-primary" @onclick="SaveTemplateFromEditingAsync">
                            Save as template
                        </button>

                        <div style="flex:1;"></div>

                        <button type="submit" class="btn btn-primary">Save group</button>
                        <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                    </div>

                    <div style="display:flex; gap: 10px; align-items:center; margin-top: 6px;">
                        <strong>Exercises</strong>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddExercise">+ Add exercise</button>
                        <span style="opacity:.75;">(each exercise has sets)</span>
                    </div>

                    @foreach (var ex in _editing.Exercises)
                    {
                        <div style="padding: 12px; border: 1px solid rgba(0,0,0,.15); border-radius: 12px;" @key="ex.RowId">
                            <div style="display:flex; gap: 10px; align-items:center; flex-wrap:wrap;">
                                <label style="flex:1; min-width: 240px; margin: 0;">
                                    Exercise name
                                    <input class="form-control"
                                           type="text"
                                           @bind="ex.Name"
                                           @bind:event="oninput" />
                                </label>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        @onclick="() => RemoveExercise(ex.RowId)"
                                        disabled="@(_editing.Exercises.Count <= 1)">
                                    Remove exercise
                                </button>
                            </div>

                            <div style="display:flex; gap: 10px; align-items:center; margin-top: 10px;">
                                <strong>Sets</strong>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AddSet(ex.RowId)">+ Add set</button>
                            </div>

                            <div class="table-responsive" style="margin-top: 8px;">
                                <table class="table table-sm align-middle">
                                    <thead>
                                        <tr>
                                            <th style="width: 70px;">#</th>
                                            <th style="width: 180px;">Reps</th>
                                            <th style="width: 220px;">Weight</th>
                                            <th style="width: 120px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var row = 0;
                                        }
                                        @foreach (var s in ex.Sets)
                                        {
                                            row++;
                                            <tr @key="s.RowId">
                                                <td>@row</td>
                                                <td>
                                                    <input class="form-control"
                                                           type="text"
                                                           inputmode="numeric"
                                                           pattern="[0-9]*"
                                                           @bind="s.RepsText"
                                                           @bind:event="oninput" />
                                                </td>
                                                <td>
                                                    <input class="form-control"
                                                           type="text"
                                                           inputmode="decimal"
                                                           @bind="s.WeightText"
                                                           @bind:event="oninput" />
                                                </td>
                                                <td class="text-end">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger"
                                                            @onclick="() => RemoveSet(ex.RowId, s.RowId)"
                                                            disabled="@(ex.Sets.Count <= 1)">
                                                        Remove
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    private string? _error;
    private string? _info;

    private DateTime _selectedDate = DateTime.Today;
    private string? _newGroupName;

    private string? _selectedTemplateId;

    private GroupEditModel? _editing;
    private string? _templateName;

    private DateOnly SelectedDateOnly => DateOnly.FromDateTime(_selectedDate);

    private List<WorkoutGroup> GroupsForSelectedDate
        => Store.GetGroupsByDate(SelectedDateOnly).ToList();

    protected override async Task OnInitializedAsync()
    {
        await Store.LoadAsync();
    }

    private async Task CreateGroupAsync()
    {
        _error = null;
        _info = null;

        try
        {
            var g = await Store.CreateGroupAsync(SelectedDateOnly, _newGroupName ?? "Workout");
            _info = $"Created group: {g.Name}";
            _newGroupName = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task AddFromTemplateAsync()
    {
        _error = null;
        _info = null;

        try
        {
            if (!Guid.TryParse(_selectedTemplateId, out var id))
                return;

            var g = await Store.CreateGroupFromTemplateAsync(SelectedDateOnly, id);
            _info = $"Added group from template: {g.Name}";
            _selectedTemplateId = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void StartEditGroup(Guid groupId)
    {
        _error = null;
        _info = null;

        var g = Store.GetGroup(groupId);
        if (g is null) return;

        _editing = GroupEditModel.FromModel(g);
        _templateName = g.Name;
    }

    private void CancelEdit()
    {
        _editing = null;
        _templateName = null;
        _error = null;
        _info = null;
    }

    private void AddExercise()
    {
        if (_editing is null) return;

        _editing.Exercises.Add(new ExerciseEditModel
        {
            RowId = Guid.NewGuid(),
            Name = "",
            Sets = new List<SetEditModel> { new() }
        });
    }

    private void RemoveExercise(Guid exerciseRowId)
    {
        if (_editing is null) return;
        if (_editing.Exercises.Count <= 1) return;

        _editing.Exercises.RemoveAll(e => e.RowId == exerciseRowId);
    }

    private void AddSet(Guid exerciseRowId)
    {
        if (_editing is null) return;

        var ex = _editing.Exercises.FirstOrDefault(e => e.RowId == exerciseRowId);
        if (ex is null) return;

        var last = ex.Sets.LastOrDefault();
        ex.Sets.Add(new SetEditModel
        {
            RowId = Guid.NewGuid(),
            RepsText = last?.RepsText ?? "10",
            WeightText = last?.WeightText ?? "0"
        });
    }

    private void RemoveSet(Guid exerciseRowId, Guid setRowId)
    {
        if (_editing is null) return;

        var ex = _editing.Exercises.FirstOrDefault(e => e.RowId == exerciseRowId);
        if (ex is null) return;
        if (ex.Sets.Count <= 1) return;

        ex.Sets.RemoveAll(s => s.RowId == setRowId);
    }

    private async Task SaveEditedGroupAsync()
    {
        _error = null;
        _info = null;

        if (_editing is null) return;

        try
        {
            var updated = _editing.ToModel(SelectedDateOnly);
            await Store.UpdateGroupAsync(updated);
            _info = "Group saved.";
        }
        catch (ValidationException vex)
        {
            _error = vex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SaveTemplateFromEditingAsync()
    {
        _error = null;
        _info = null;

        if (_editing is null) return;

        try
        {
            var name = string.IsNullOrWhiteSpace(_templateName) ? _editing.Name : _templateName;
            await SaveEditedGroupAsync(); // ensure latest changes are persisted first
            await Store.SaveGroupAsTemplateAsync(_editing.GroupId, name ?? "Template");
            _info = "Template saved.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteGroupAsync(Guid groupId)
    {
        _error = null;
        _info = null;

        try
        {
            await Store.DeleteGroupAsync(groupId);

            if (_editing?.GroupId == groupId)
                CancelEdit();

            _info = "Group deleted.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteTemplateAsync(Guid templateId)
    {
        _error = null;
        _info = null;

        try
        {
            await Store.DeleteTemplateAsync(templateId);
            _info = "Template deleted.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private static string RenderGroupSummary(WorkoutGroup g)
    {
        if (g.Exercises.Count == 0) return "No exercises yet.";
        return string.Join(" · ", g.Exercises.Select(e => $"{e.Name} ({e.Sets.Count} sets)"));
    }

    // ===== UI edit models (string-based to avoid iOS number input issues) =====

    private sealed class GroupEditModel
    {
        [Required]
        [StringLength(80)]
        public string Name { get; set; } = "Workout";

        public Guid GroupId { get; set; }

        [MinLength(1, ErrorMessage = "Add at least one exercise.")]
        public List<ExerciseEditModel> Exercises { get; set; } = new();

        public static GroupEditModel FromModel(WorkoutGroup g)
        {
            return new GroupEditModel
            {
                GroupId = g.Id,
                Name = g.Name,
                Exercises = g.Exercises.Select(ExerciseEditModel.FromModel).ToList()
            };
        }

        public WorkoutGroup ToModel(DateOnly date)
        {
            var name = (Name ?? "").Trim();
            if (string.IsNullOrWhiteSpace(name))
                throw new ValidationException("Group name is required.");

            var exercises = Exercises.Select((e, idx) => e.ToModel(idx + 1)).ToList();
            if (exercises.Count == 0)
                throw new ValidationException("Add at least one exercise.");

            return new WorkoutGroup
            {
                Id = GroupId,
                WorkoutDate = date,
                Name = name,
                Exercises = exercises
            };
        }
    }

    private sealed class ExerciseEditModel
    {
        public Guid RowId { get; set; } = Guid.NewGuid();
        public string Name { get; set; } = "";

        public List<SetEditModel> Sets { get; set; } = new() { new SetEditModel() };

        public static ExerciseEditModel FromModel(WorkoutExercise e)
        {
            return new ExerciseEditModel
            {
                RowId = Guid.NewGuid(),
                Name = e.Name,
                Sets = e.Sets.Select(SetEditModel.FromModel).ToList()
            };
        }

        public WorkoutExercise ToModel(int exerciseNumber)
        {
            var n = (Name ?? "").Trim();
            if (string.IsNullOrWhiteSpace(n))
                throw new ValidationException($"Exercise {exerciseNumber}: name is required.");

            var sets = new List<ExerciseSet>();
            for (var i = 0; i < Sets.Count; i++)
            {
                sets.Add(Sets[i].ToModel(exerciseNumber, i + 1));
            }

            if (sets.Count == 0)
                throw new ValidationException($"Exercise {exerciseNumber}: add at least one set.");

            return new WorkoutExercise
            {
                Id = Guid.NewGuid(),
                Name = n,
                Sets = sets
            };
        }
    }

    private sealed class SetEditModel
    {
        public Guid RowId { get; set; } = Guid.NewGuid();
        public string RepsText { get; set; } = "10";
        public string WeightText { get; set; } = "0";

        public static SetEditModel FromModel(ExerciseSet s)
        {
            return new SetEditModel
            {
                RowId = Guid.NewGuid(),
                RepsText = s.Reps.ToString(CultureInfo.InvariantCulture),
                WeightText = s.Weight.ToString(CultureInfo.InvariantCulture)
            };
        }

        public ExerciseSet ToModel(int exerciseNumber, int setNumber)
        {
            if (!int.TryParse((RepsText ?? "").Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var reps))
                throw new ValidationException($"Exercise {exerciseNumber}, set {setNumber}: reps must be a whole number.");

            var wText = (WeightText ?? "").Trim().Replace(',', '.');
            if (!decimal.TryParse(wText, NumberStyles.Number, CultureInfo.InvariantCulture, out var weight))
                throw new ValidationException($"Exercise {exerciseNumber}, set {setNumber}: weight must be a number.");

            return new ExerciseSet { Reps = reps, Weight = weight };
        }
    }
}